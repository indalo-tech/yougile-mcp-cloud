# Copy to .env next to compose.yaml, fill in, chmod 600. Never commit the real file.
# Secrets: docker run --rm ghcr.io/indalo-tech/yougile-mcp-cloud:<tag> yougile-cloud genkeys
# Passwords: openssl rand -hex 24 (hex keeps them safe inside connection URLs).

PUBLIC_URL=https://yougile.example.com
ENCRYPTION_KEYS=
JWT_SECRET=
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# YouGile company ids that never pay (your own companies), comma-separated.
FREE_COMPANY_IDS=
TRIAL_DAYS=14

# Set by deploy.sh on every deploy; pin or roll back by hand the same way.
IMAGE_TAG=
